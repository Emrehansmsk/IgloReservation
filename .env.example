# Copy to .env and fill in real values. Never commit .env.

# --- PostgreSQL ---
POSTGRES_DB=IgloReservationDb
POSTGRES_USER=iglo_app
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# --- API (published for local smoke; behind Caddy in production you can leave 8080) ---
API_PUBLISH_PORT=8080

# --- JWT (required in Production) ---
# Generate e.g.: openssl rand -base64 48
JWT_SIGNING_KEY=CHANGE_ME_long_random_signing_key
JWT_ISSUER=IgloReservation
JWT_AUDIENCE=IgloReservation
JWT_ACCESS_TOKEN_MINUTES=60

# --- Admin bootstrap (optional; creates Admin only if email is unused) ---
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_strong_admin_password

# --- CORS: Vercel frontend origins (no trailing slash) ---
CORS_ORIGIN_0=https://your-app.vercel.app
CORS_ORIGIN_1=

# --- Caddy TLS profile only (`docker compose --profile tls up -d`) ---
# DNS A/AAAA for this host must point at the VPS before Let's Encrypt can succeed.
API_HOST=api.example.com
